# Postgres. Neon works out of the box; append ?pgbouncer=true to the pooled URL.
DATABASE_URL="postgresql://mockbird:mockbird@localhost:5432/mockbird"

# Public origin, used to build the mock URLs shown in the UI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI generation. Leave both unset — the app stays fully usable with the
# "Write it" tab and the manual JSON editor. Free key: console.groq.com
GROQ_API_KEY=""
AI_MODEL="openai/gpt-oss-20b"

# Optional. Without these, caching and rate limiting fall back to an in-process
# map, which is correct for local dev and per-instance on serverless.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Requests per minute allowed per workspace key on the mock route.
MOCK_RATE_LIMIT="60"
